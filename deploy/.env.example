# Written once on the box as ~/openfold/.env, readable by its owner only (chmod 600).
# The database user is the game's own: it never uses the host's postgres or another product's.
DB_USER=openfold
DB_PASSWORD=change-me-and-keep-it-out-of-git
DB_NAME=openfold
API_PORT=8710
# Who the API believes. There is no default: the API exits at boot without a mode it knows.
#
# session (NEXT 18 e) signs players in by an email link and by Google, and reads them from a session cookie
# that is httpOnly, Secure and SameSite=Lax. It is the mode a box real players reach runs, once the Fable
# auth review the owner asked for has passed.
#   PUBLIC_ORIGIN  the origin this API answers on, https (http only on localhost); the OAuth redirect
#                  {PUBLIC_ORIGIN}/auth/google/callback must be listed on the Google client
#   APP_ORIGIN     the origin the game is served from; the browser goes back there after a sign-in
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET  both or neither (Google then answers "not open yet"); on the
#                  laptop they sit in the owner's secrets folder, on the box in this file, never in git
#   MAILER         who sends the email link; `log` (the only one so far) writes it to the API's log, and the
#                  real sender waits for the owner's choice (NEXT 18 h5)
#
# dev-header trusts a request header as the player's identity, so ANYONE who can reach the API can act as
# any player. It exists for a staging box no real player reaches, and it starts only with ALLOW_DEV_HEADER.
# The two never run together: session refuses to start while ALLOW_DEV_HEADER is set.
AUTH_MODE=dev-header
ALLOW_DEV_HEADER=staging-only
# AUTH_MODE=session
# PUBLIC_ORIGIN=https://api.openfold.example
# APP_ORIGIN=https://openfold.example
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MAILER=log
