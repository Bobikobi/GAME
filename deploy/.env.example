# Written once on the box as ~/openfold/.env, readable by its owner only (chmod 600).
# The database user is the game's own: it never uses the host's postgres or another product's.
DB_USER=openfold
DB_PASSWORD=change-me-and-keep-it-out-of-git
DB_NAME=openfold
API_PORT=8710
# Who the API believes. There is no default: the API exits at boot without a mode it knows.
#
# session (NEXT 18 e) signs players in by an email link and by Google, and reads them from a session cookie
# that is httpOnly, Secure and SameSite=Lax. It is the mode a box real players reach runs, once the Fable
# auth review the owner asked for has passed.
#   PUBLIC_ORIGIN  the origin this API answers on, https (http only on localhost); the OAuth redirect
#                  {PUBLIC_ORIGIN}/auth/google/callback must be listed on the Google client. The one place the
#                  name is typed: the nginx site file is derived from it (RUNBOOK step 3) and the certificate
#                  is asked for it (step 4). Set it in dev-header mode already, which ignores it
#   APP_ORIGIN     leave it unset: the game's build is served beside the API under the same name (RUNBOOK
#                  step 3), so the game's origin is PUBLIC_ORIGIN and the session cookie never crosses an
#                  origin. The API refuses any other value; only a laptop may pair two loopback ports
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET  both or neither (Google then answers "not open yet"); on the
#                  laptop they sit in the owner's secrets folder, on the box in this file, never in git
#   MAILER         who sends the email link; `log` (the only one so far) writes it to the API's log, and the
#                  real sender waits for the owner's choice (NEXT 18 h5). A live link in a log signs anyone in
#                  who reads it, so `log` starts only beside ALLOW_LOG_MAILER=staging-only: a staging box.
#                  The real sender must not rewrite links for click tracking: the token rides after `#`
#   CLIENT_ADDRESS_HEADER  the header our nginx sets to the client's address (X-Real-IP); the sign-in limits
#                  count by it. Required unless PUBLIC_ORIGIN is a loopback host, since behind nginx every
#                  request comes from nginx
#   COUNTRY_HEADER the header our nginx sets to the visitor's country by GeoIP (X-Country); it sets the age
#                  limit of a sign-up. Unset, every sign-up is held to the highest age. Set it only once nginx
#                  fills it (RUNBOOK step 6): the player is never asked where they are
#
# dev-header trusts a request header as the player's identity, so ANYONE who can reach the API can act as
# any player. It exists for a staging box no real player reaches, and it starts only with ALLOW_DEV_HEADER.
# The two never run together: session refuses to start while ALLOW_DEV_HEADER is set.
AUTH_MODE=dev-header
ALLOW_DEV_HEADER=staging-only
# AUTH_MODE=session
# PUBLIC_ORIGIN=https://play.loomvale.example
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MAILER=log
# ALLOW_LOG_MAILER=staging-only
# CLIENT_ADDRESS_HEADER=X-Real-IP
# COUNTRY_HEADER=X-Country
