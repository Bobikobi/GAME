# Written once on the box as ~/openfold/.env, readable by its owner only (chmod 600).
# The database user is the game's own: it never uses the host's postgres or another product's.
DB_USER=openfold
DB_PASSWORD=change-me-and-keep-it-out-of-git
DB_NAME=openfold
API_PORT=8710
# Who the API believes. There is no default: the API exits at boot without a mode it knows.
# dev-header trusts a request header as the player's identity, so ANYONE who can reach the API can act as
# any player. It exists for a staging box no real player reaches, and it starts only with the second line.
# NEXT 18 e (sign-in by email, Google, Discord) adds the mode a public box needs; until then do not point
# the name at the box.
AUTH_MODE=dev-header
ALLOW_DEV_HEADER=staging-only
