{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Body of POST /api/s1/visit and /api/s1/pickup.",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
      "maxLength": 80,
      "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
      "type": "string"
    }
  },
  "$id": "https://github.com/Bobikobi/GAME/schema/json/s1-record.schema.json"
}
