        "craft_luck_max_permille",
        "craft_miss_keep_pct",
        "wear_effect_max_pct",
        "wear_set_bonus_pct",
        "rarity_bonus_ms",
        "drift_budget_permille",
        "satiety_cap",
        "satiety_drain_per_min",
        "day_length_ms",
        "bag_base",
        "starting_gold_mg",
        "per_point"
      ],
      "properties": {
        "k_permille": {
