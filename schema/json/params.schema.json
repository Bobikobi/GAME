        },
        "tier_min_level": {
          "minItems": 1,
          "maxItems": 20,
          "description": "The lowest level of each tier, from tier 1. A recipe of tier t needs a level from entry t up to one below entry t + 1 (up to 20 for the last), and a node that gives tier 3 or above needs at least entry t, or a slow respawn. Starts at 1 and rises with every tier; one entry for every open tier at least.",
          "type": "array",
          "items": {
            "minimum": 1,
            "maximum": 20,
            "type": "integer"
          }
        },
        "template_max_recipes": {
          "additionalProperties": false,
