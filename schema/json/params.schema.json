              }
            }
          }
        },
        "power_cap_permille": {
          "minItems": 1,
          "maxItems": 40,
          "description": "P(level): the clamp on any rate multiplier, by character level (1-based).",
          "type": "array",
          "items": {
            "minimum": 1000,
            "maximum": 10000,
            "type": "integer"
          }
        },
        "rarity_budget_permille": {
