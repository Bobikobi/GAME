{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "$id": "https://github.com/Bobikobi/GAME/schema/json/race.schema.json",
  "type": "object",
  "required": [
    "format",
    "id",
    "title",
    "creator",
    "type",
    "race"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "description": "Format version of this file.",
      "const": 1,
      "type": "number"
    },
    "id": {
      "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
      "maxLength": 80,
      "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "maxLength": 40,
      "type": "string"
    },
    "creator": {
      "pattern": "^[a-z0-9_-]+$",
      "maxLength": 39,
      "description": "GitHub handle, lowercase.",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "maxLength": 240,
      "type": "string"
    },
    "ai_tools": {
      "maxItems": 8,
      "description": "AI tools used to make this file or its art. Required when any were used.",
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 60,
        "type": "string"
      }
    },
    "items": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "rarity",
          "sprite",
          "weight"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
            "maxLength": 80,
            "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 40,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "maxLength": 240,
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "const": "material",
                "type": "string"
              },
              {
                "const": "food",
                "type": "string"
              },
              {
                "const": "tool",
                "type": "string"
              },
              {
                "const": "fragment",
                "type": "string"
              },
              {
                "const": "treasure",
                "type": "string"
              }
            ]
          },
          "rarity": {
            "description": "Declared rarity. The check compares it with the rarity computed from the data.",
            "anyOf": [
              {
                "const": "common",
                "type": "string"
              },
              {
                "const": "uncommon",
                "type": "string"
              },
              {
                "const": "rare",
                "type": "string"
              },
              {
                "const": "legendary",
                "type": "string"
              }
            ]
          },
          "class": {
            "description": "A base class (plant, wood, fibre, ...) or the id of a class an extension declares under one of them.",
            "anyOf": [
              {
                "const": "plant",
                "type": "string"
              },
              {
                "const": "wood",
                "type": "string"
              },
              {
                "const": "fibre",
                "type": "string"
              },
              {
                "const": "stone",
                "type": "string"
              },
              {
                "const": "clay",
                "type": "string"
              },
              {
                "const": "mineral",
                "type": "string"
              },
              {
                "const": "metal",
                "type": "string"
              },
              {
                "const": "animal",
                "type": "string"
              },
              {
                "const": "meal",
                "type": "string"
              },
              {
                "const": "tool",
                "type": "string"
              },
              {
                "const": "garment",
                "type": "string"
              },
              {
                "const": "jewelry",
                "type": "string"
              },
              {
                "const": "relic",
                "type": "string"
              },
              {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                "maxLength": 80,
                "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                "type": "string"
              }
            ]
          },
          "family": {
            "pattern": "^[a-z0-9_-]+$",
            "maxLength": 24,
            "description": "A group inside the class, for example \"berry\" for every berry. Open: any lowercase word.",
            "type": "string"
          },
          "tags": {
            "maxItems": 8,
            "uniqueItems": true,
            "description": "Open words that describe it, for example \"sweet\" or \"night\".",
            "type": "array",
            "items": {
              "pattern": "^[a-z0-9_-]+$",
              "maxLength": 24,
              "description": "A lowercase word.",
              "type": "string"
            }
          },
          "tier": {
            "minimum": 1,
            "maximum": 20,
            "description": "How advanced it is, from 1. The rarity says how often it appears; the tier says how far up the ladder it is. A tool has the tier of its \"tool\".",
            "type": "integer"
          },
          "sprite": {
            "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+:[a-z0-9_/-]+$",
            "maxLength": 120,
            "description": "A frame of an art kit: \"<kit id>:<frame name>\", for example \"core/base-kit:items/berry\".",
            "type": "string"
          },
          "weight": {
            "minimum": 0,
            "maximum": 20,
            "description": "How heavy one unit is (DECISIONS.md, 2026-10-23): 0 for herbs, seeds and coins, 1 for most things, 3 for logs, stone and ore. The load against the weight limit sets the walking pace.",
            "type": "integer"
          },
          "food": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "satiety"
            ],
            "properties": {
              "satiety": {
                "minimum": 0,
                "maximum": 100,
                "description": "Health points restored when eaten (the meter holds 100 at the start). 0 for a food that only hurts.",
                "type": "integer"
              },
              "hurt": {
                "minimum": 1,
                "maximum": 100,
                "description": "Health points it takes when eaten, at any hour: a bad fruit or a raw herb (G30).",
                "type": "integer"
              }
            }
          },
          "tool": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "tier"
            ],
            "properties": {
              "kind": {
                "anyOf": [
                  {
                    "const": "basket",
                    "type": "string"
                  },
                  {
                    "const": "trowel",
                    "type": "string"
                  },
                  {
                    "const": "axe",
                    "type": "string"
                  },
                  {
                    "const": "staff",
                    "type": "string"
                  },
                  {
                    "const": "hammer",
                    "type": "string"
                  },
                  {
                    "const": "pick",
                    "type": "string"
                  },
                  {
                    "const": "rod",
                    "type": "string"
                  }
                ]
              },
              "tier": {
                "minimum": 1,
                "maximum": 5,
                "description": "Better tools work faster. The calculator clamps the total.",
                "type": "integer"
              },
              "uses": {
                "minimum": 1,
                "maximum": 1000,
                "description": "The tool wears out after this many uses. Left out, the tool lasts (DECISIONS.md, 2026-10-09: the crafting economy).",
                "type": "integer"
              }
            }
          },
          "weapon": {
            "additionalProperties": false,
            "description": "A hand that strikes (WEAPONS 3). No class field: the class is the item's own. Every weapon block in content is refused until combat (G35, G44).",
            "type": "object",
            "required": [
              "tempo",
              "windup_t",
              "reach",
              "harm"
            ],
            "properties": {
              "tempo": {
                "description": "The swing, the hand's one cooldown: quick, standard or heavy, each a combat param in ticks (WEAPONS 3; COMBAT 4.9). Read by nothing until combat.",
                "anyOf": [
                  {
                    "const": "quick",
                    "type": "string"
                  },
                  {
                    "const": "standard",
                    "type": "string"
                  },
                  {
                    "const": "heavy",
                    "type": "string"
                  }
                ]
              },
              "windup_t": {
                "minimum": 2,
                "maximum": 10,
                "description": "Ticks from the press to the landing, inside the swing (WEAPONS 3).",
                "type": "integer"
              },
              "reach": {
                "minimum": 1,
                "maximum": 2,
                "description": "Tiles, no diagonal; 2 is a long hand (WEAPONS 3).",
                "type": "integer"
              },
              "harm": {
                "minimum": 0,
                "maximum": 1000,
                "description": "The hand's bonus in points, counted as harm + hand_offset (WEAPONS 3, 4).",
                "type": "integer"
              },
              "range": {
                "minimum": 2,
                "maximum": 12,
                "description": "Tiles, only on a hand that throws or shoots (WEAPONS 3).",
                "type": "integer"
              },
              "ammo": {
                "description": "The ammunition class a launcher spends (WEAPONS 3, 6). Not the item-level ammunition block, which comes with the first shot (WEAPONS 6).",
                "anyOf": [
                  {
                    "const": "plant",
                    "type": "string"
                  },
                  {
                    "const": "wood",
                    "type": "string"
                  },
                  {
                    "const": "fibre",
                    "type": "string"
                  },
                  {
                    "const": "stone",
                    "type": "string"
                  },
                  {
                    "const": "clay",
                    "type": "string"
                  },
                  {
                    "const": "mineral",
                    "type": "string"
                  },
                  {
                    "const": "metal",
                    "type": "string"
                  },
                  {
                    "const": "animal",
                    "type": "string"
                  },
                  {
                    "const": "meal",
                    "type": "string"
                  },
                  {
                    "const": "tool",
                    "type": "string"
                  },
                  {
                    "const": "garment",
                    "type": "string"
                  },
                  {
                    "const": "jewelry",
                    "type": "string"
                  },
                  {
                    "const": "relic",
                    "type": "string"
                  },
                  {
                    "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                    "maxLength": 80,
                    "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                    "type": "string"
                  }
                ]
              },
              "noise": {
                "minimum": 0,
                "maximum": 12,
                "description": "Tiles a landed strike is heard; left out, wild.strike_noise (WEAPONS 3).",
                "type": "integer"
              },
              "uses": {
                "minimum": 1,
                "maximum": 1000,
                "description": "Landed hits before it breaks; left out, it lasts (WEAPONS 3, 7).",
                "type": "integer"
              }
            }
          },
          "fragment": {
            "additionalProperties": false,
            "description": "A found scrap that teaches a recipe.",
            "type": "object",
            "required": [
              "unlocks"
            ],
            "properties": {
              "unlocks": {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                "maxLength": 80,
                "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                "type": "string"
              }
            }
          },
          "wear": {
            "additionalProperties": false,
            "description": "Something the character wears (DECISIONS.md, 2026-10-09: the upgrade). A worn item stays in the bag; it takes no place there, but its weight counts (2026-10-23).",
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "description": "Where it is worn: head, top, legs (trousers), outfit (takes the top and the legs), feet, jewelry (two places), hand (a tool) or back (one bag or one quiver).",
                "anyOf": [
                  {
                    "const": "head",
                    "type": "string"
                  },
                  {
                    "const": "top",
                    "type": "string"
                  },
                  {
                    "const": "legs",
                    "type": "string"
                  },
                  {
                    "const": "outfit",
                    "type": "string"
                  },
                  {
                    "const": "feet",
                    "type": "string"
                  },
                  {
                    "const": "jewelry",
                    "type": "string"
                  },
                  {
                    "const": "hand",
                    "type": "string"
                  },
                  {
                    "const": "back",
                    "type": "string"
                  }
                ]
              },
              "look": {
                "description": "A look: worn on the look layer over the work clothes. It shows and counts for nothing, so it has no effects and no set.",
                "type": "boolean"
              },
              "effects": {
                "minItems": 1,
                "maxItems": 2,
                "description": "Small bonuses while it is worn on the work layer. Two at most, each effect once.",
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "effect",
                    "value"
                  ],
                  "properties": {
                    "effect": {
                      "description": "What a worn item helps: gathering, digging or crafting speed, the craft chance, or rare finds.",
                      "anyOf": [
                        {
                          "const": "gather_speed_pct",
                          "type": "string"
                        },
                        {
                          "const": "dig_speed_pct",
                          "type": "string"
                        },
                        {
                          "const": "craft_speed_pct",
                          "type": "string"
                        },
                        {
                          "const": "craft_chance_pct",
                          "type": "string"
                        },
                        {
                          "const": "rare_find_pct",
                          "type": "string"
                        }
                      ]
                    },
                    "value": {
                      "minimum": 1,
                      "maximum": 100,
                      "description": "Percent, at most the cap of the item's tier (params.wear_effect_max_pct).",
                      "type": "integer"
                    }
                  }
                }
              },
              "set": {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                "maxLength": 80,
                "description": "A set of one creator: when every piece of it is worn, their effects grow by params.wear_set_bonus_pct.",
                "type": "string"
              },
              "places": {
                "minimum": 1,
                "maximum": 99,
                "description": "A bag on the back: the places it gives, instead of the hands' `bag_base`. Only a work piece on the back carries it (DECISIONS.md, 2026-10-23).",
                "type": "integer"
              },
              "load_bonus": {
                "minimum": 1,
                "maximum": 100,
                "description": "A bag on the back that moves the load to the hips: what it adds to the weight limit (`load.base` + might). Needs `places`.",
                "type": "integer"
              },
              "req": {
                "additionalProperties": false,
                "description": "A soft requirement: below it the piece counts up to what gear one tier above the wearer's own gives (PROGRESSION 5.6; CLOTHING 7.4). Read by nothing yet.",
                "type": "object",
                "required": [
                  "school",
                  "level"
                ],
                "properties": {
                  "school": {
                    "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                    "maxLength": 80,
                    "description": "The profession whose level the piece asks (CLOTHING 7.4).",
                    "type": "string"
                  },
                  "level": {
                    "minimum": 1,
                    "maximum": 100,
                    "description": "The level asked: exactly wear_req_level of the piece's tier.",
                    "type": "integer"
                  },
                  "attr": {
                    "additionalProperties": false,
                    "minProperties": 1,
                    "type": "object",
                    "properties": {
                      "might": {
                        "minimum": 1,
                        "maximum": 100,
                        "type": "integer"
                      },
                      "senses": {
                        "minimum": 1,
                        "maximum": 100,
                        "type": "integer"
                      },
                      "agility": {
                        "minimum": 1,
                        "maximum": 100,
                        "type": "integer"
                      },
                      "luck": {
                        "minimum": 1,
                        "maximum": 100,
                        "type": "integer"
                      },
                      "stamina": {
                        "minimum": 1,
                        "maximum": 100,
                        "type": "integer"
                      },
                      "spirit": {
                        "minimum": 1,
                        "maximum": 100,
                        "type": "integer"
                      }
                    },
                    "description": "Base attribute points the piece asks too; worn bonuses never count toward them."
                  }
                }
              },
              "attrs": {
                "additionalProperties": false,
                "minProperties": 1,
                "type": "object",
                "properties": {
                  "might": {
                    "minimum": 1,
                    "maximum": 100,
                    "type": "integer"
                  },
                  "senses": {
                    "minimum": 1,
                    "maximum": 100,
                    "type": "integer"
                  },
                  "agility": {
                    "minimum": 1,
                    "maximum": 100,
                    "type": "integer"
                  },
                  "luck": {
                    "minimum": 1,
                    "maximum": 100,
                    "type": "integer"
                  },
                  "stamina": {
                    "minimum": 1,
                    "maximum": 100,
                    "type": "integer"
                  },
                  "spirit": {
                    "minimum": 1,
                    "maximum": 100,
                    "type": "integer"
                  }
                },
                "description": "Bonuses on top of the base attributes, each at most attr_bonus_max of the piece's tier (PROGRESSION 5.6; CLOTHING 7.5). Refused in content until a verb reads them."
              },
              "trait": {
                "description": "What the piece is worn against: a place's condition (BODY_CLOCKS 6.1). Refused in content until the first place condition.",
                "anyOf": [
                  {
                    "const": "cold_proof",
                    "type": "string"
                  },
                  {
                    "const": "snow_shod",
                    "type": "string"
                  },
                  {
                    "const": "storm_proof",
                    "type": "string"
                  },
                  {
                    "const": "ice_grip",
                    "type": "string"
                  },
                  {
                    "const": "heat_ward",
                    "type": "string"
                  }
                ]
              }
            }
          },
          "grade": {
            "additionalProperties": false,
            "description": "A finer grade of another item: the same good off a better animal. A stack splits by grade the way it splits by tier, so each grade is an item of its own; it keeps the plain item's class, kind, tier and value, and a recipe asks for it with \"min_grade\".",
            "type": "object",
            "required": [
              "of",
              "step"
            ],
            "properties": {
              "of": {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                "maxLength": 80,
                "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                "type": "string"
              },
              "step": {
                "minimum": 2,
                "maximum": 3,
                "description": "2 is fine, 3 is true. A grade is read as a pose on the screen, never as a number (HUNTING section 5).",
                "type": "integer"
              }
            }
          },
          "premium_later": {
            "description": "Marks a look that may also be sold for premium currency once stage 6 brings it. Only a look item with no effect may carry it, and it stays obtainable in the game (DECISIONS.md, 2026-10-09).",
            "type": "boolean"
          },
          "bind": {
            "description": "Who may hold it: none trades, account never trades or sells, character never trades; left out, none (EQUIPMENT 3.6). Only a look binds; power is never bound. Read by nothing yet.",
            "anyOf": [
              {
                "const": "none",
                "type": "string"
              },
              {
                "const": "account",
                "type": "string"
              },
              {
                "const": "character",
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "classes": {
      "maxItems": 10,
      "description": "Classes of your own, each under one base class.",
      "type": "array",
      "items": {
        "additionalProperties": false,
        "description": "A class of your own, declared under one base class. Every rule written for the base class holds for it.",
        "type": "object",
        "required": [
          "id",
          "name",
          "base"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
            "maxLength": 80,
            "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 40,
            "type": "string"
          },
          "base": {
            "description": "plant (leaves, herbs, berries, fruit, roots, mushrooms), wood, fibre (reeds, grass, thread, cloth), stone, clay (clay, sand, pottery, brick), mineral (crystals, gems, salt, ore), metal (waits for its discovery), animal (feathers, wool, hide, bone), meal (cooked food), tool, garment (worn clothes), jewelry, relic (old things from the ruins).",
            "anyOf": [
              {
                "const": "plant",
                "type": "string"
              },
              {
                "const": "wood",
                "type": "string"
              },
              {
                "const": "fibre",
                "type": "string"
              },
              {
                "const": "stone",
                "type": "string"
              },
              {
                "const": "clay",
                "type": "string"
              },
              {
                "const": "mineral",
                "type": "string"
              },
              {
                "const": "metal",
                "type": "string"
              },
              {
                "const": "animal",
                "type": "string"
              },
              {
                "const": "meal",
                "type": "string"
              },
              {
                "const": "tool",
                "type": "string"
              },
              {
                "const": "garment",
                "type": "string"
              },
              {
                "const": "jewelry",
                "type": "string"
              },
              {
                "const": "relic",
                "type": "string"
              }
            ]
          },
          "description": {
            "minLength": 1,
            "maxLength": 240,
            "type": "string"
          }
        }
      }
    },
    "type": {
      "const": "race",
      "type": "string"
    },
    "race": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "about",
        "attributes",
        "home",
        "sprite"
      ],
      "properties": {
        "name": {
          "minLength": 1,
          "maxLength": 40,
          "type": "string"
        },
        "about": {
          "minLength": 1,
          "maxLength": 240,
          "type": "string",
          "description": "Who they are, in one or two present-tense sentences, shown on the title card."
        },
        "attributes": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "might",
            "senses",
            "agility",
            "luck",
            "stamina",
            "spirit"
          ],
          "properties": {
            "might": {
              "minimum": 0,
              "maximum": 5,
              "description": "Bag places; heavy work; later combat. Was \"carry\".",
              "type": "integer"
            },
            "senses": {
              "minimum": 0,
              "maximum": 5,
              "type": "integer"
            },
            "agility": {
              "minimum": 0,
              "maximum": 5,
              "type": "integer"
            },
            "luck": {
              "minimum": 0,
              "maximum": 5,
              "type": "integer"
            },
            "stamina": {
              "minimum": 0,
              "maximum": 5,
              "type": "integer"
            },
            "spirit": {
              "minimum": 0,
              "maximum": 5,
              "type": "integer"
            }
          },
          "description": "The fixed profile: no free points at the title. The check holds every race to one total."
        },
        "home": {
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "description": "The two home attributes: a world that is strong for the race lifts each by one, a weak world lowers each by one (never below 0).",
          "type": "array",
          "items": {
