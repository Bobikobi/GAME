{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "$id": "https://github.com/Bobikobi/GAME/schema/json/map.schema.json",
  "type": "object",
  "required": [
    "format",
    "id",
    "title",
    "creator",
    "type",
    "map"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "description": "Format version of this file.",
      "const": 1,
      "type": "number"
    },
    "id": {
      "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
      "maxLength": 80,
      "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "maxLength": 40,
      "type": "string"
    },
    "creator": {
      "pattern": "^[a-z0-9_-]+$",
      "maxLength": 39,
      "description": "GitHub handle, lowercase.",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "maxLength": 240,
      "type": "string"
    },
    "ai_tools": {
      "maxItems": 8,
      "description": "AI tools used to make this file or its art. Required when any were used.",
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 60,
        "type": "string"
      }
    },
    "items": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "rarity",
          "sprite"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
            "maxLength": 80,
            "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 40,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "maxLength": 240,
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "const": "material",
                "type": "string"
              },
              {
                "const": "food",
                "type": "string"
              },
              {
                "const": "tool",
                "type": "string"
              },
              {
                "const": "fragment",
                "type": "string"
              },
              {
                "const": "treasure",
                "type": "string"
              }
            ]
          },
          "rarity": {
            "description": "Declared rarity. The check compares it with the rarity computed from the data.",
            "anyOf": [
              {
                "const": "common",
                "type": "string"
              },
              {
                "const": "uncommon",
                "type": "string"
              },
              {
                "const": "rare",
                "type": "string"
              },
              {
                "const": "legendary",
                "type": "string"
              }
            ]
          },
          "sprite": {
            "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+:[a-z0-9_/-]+$",
            "maxLength": 120,
            "description": "A frame of an art kit: \"<kit id>:<frame name>\", for example \"core/base-kit:items/berry\".",
            "type": "string"
          },
          "food": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "satiety"
            ],
            "properties": {
              "satiety": {
                "minimum": 1,
                "maximum": 100,
                "description": "Satiety points restored when eaten (the meter holds 100 at the start).",
                "type": "integer"
              }
            }
          },
          "tool": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "tier",
              "uses"
            ],
            "properties": {
              "kind": {
                "anyOf": [
                  {
                    "const": "basket",
                    "type": "string"
                  },
                  {
                    "const": "trowel",
                    "type": "string"
                  }
                ]
              },
              "tier": {
                "minimum": 1,
                "maximum": 5,
                "description": "Better tools work faster. The calculator clamps the total.",
                "type": "integer"
              },
              "uses": {
                "minimum": 1,
                "maximum": 1000,
                "description": "The tool wears out after this many uses.",
                "type": "integer"
              }
            }
          },
          "fragment": {
            "additionalProperties": false,
            "description": "A found scrap that teaches a recipe.",
            "type": "object",
            "required": [
              "unlocks"
            ],
            "properties": {
              "unlocks": {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                "maxLength": 80,
                "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "type": {
      "const": "map",
      "type": "string"
    },
    "map": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "width",
        "height",
        "legend",
        "ground",
        "props",
        "spawn",
        "slots"
      ],
      "properties": {
        "width": {
          "minimum": 8,
          "maximum": 1024,
          "type": "integer"
        },
        "height": {
          "minimum": 8,
          "maximum": 1024,
          "type": "integer"
        },
        "legend": {
          "type": "object",
          "patternProperties": {
            "^.$": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "sprite",
                "solid",
                "tag"
              ],
              "properties": {
                "sprite": {
                  "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+:[a-z0-9_/-]+$",
                  "maxLength": 120,
                  "description": "A frame of an art kit: \"<kit id>:<frame name>\", for example \"core/base-kit:items/berry\".",
                  "type": "string"
                },
                "solid": {
                  "type": "boolean"
                },
                "tag": {
                  "anyOf": [
                    {
                      "const": "grove",
                      "type": "string"
                    },
                    {
                      "const": "meadow",
                      "type": "string"
                    },
                    {
                      "const": "riverbank",
                      "type": "string"
                    },
                    {
                      "const": "ruin",
                      "type": "string"
                    },
                    {
                      "const": "town",
                      "type": "string"
                    },
                    {
                      "const": "water",
                      "type": "string"
                    },
                    {
                      "const": "path",
                      "type": "string"
                    },
                    {
                      "const": "interior",
                      "type": "string"
                    }
                  ]
                }
              }
            }
          }
        },
        "ground": {
          "minItems": 8,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "props": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "sprite",
              "x",
              "y",
              "w",
              "h",
              "solid"
            ],
            "properties": {
              "sprite": {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+:[a-z0-9_/-]+$",
                "maxLength": 120,
                "description": "A frame of an art kit: \"<kit id>:<frame name>\", for example \"core/base-kit:items/berry\".",
                "type": "string"
              },
              "x": {
                "minimum": 0,
                "maximum": 1023,
                "description": "Left tile of the footprint.",
                "type": "integer"
              },
              "y": {
                "minimum": 0,
                "maximum": 1023,
                "description": "Top tile of the footprint.",
                "type": "integer"
              },
              "w": {
                "minimum": 1,
                "maximum": 8,
                "description": "Footprint width in tiles. The sprite is drawn bottom-centered on it.",
                "type": "integer"
              },
              "h": {
                "minimum": 1,
                "maximum": 8,
                "description": "Footprint height in tiles.",
                "type": "integer"
              },
              "solid": {
                "type": "boolean"
              },
              "sign": {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                "maxLength": 80,
                "description": "Makes the prop a readable sign that names whoever filled this slot, or says it awaits restoration.",
                "type": "string"
              },
              "note": {
                "minLength": 1,
                "maxLength": 240,
                "type": "string",
                "description": "A line shown when the player looks at this prop, for example an old inscription."
              }
            }
          }
        },
        "spawn": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "minimum": 0,
              "maximum": 1023,
              "type": "integer"
            },
            "y": {
              "minimum": 0,
              "maximum": 1023,
              "type": "integer"
            }
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "id",
              "kind",
              "x",
              "y",
              "w",
              "h"
            ],
            "properties": {
              "id": {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                "maxLength": 80,
                "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                "type": "string"
              },
              "kind": {
                "anyOf": [
                  {
                    "const": "resource",
                    "type": "string"
                  },
                  {
                    "const": "ruin",
                    "type": "string"
                  },
                  {
                    "const": "npc",
                    "type": "string"
                  },
                  {
                    "const": "building",
                    "type": "string"
                  },
                  {
                    "const": "restore",
                    "type": "string"
                  },
                  {
                    "const": "camp",
                    "type": "string"
                  },
                  {
                    "const": "area",
                    "type": "string"
                  }
                ]
              },
              "x": {
                "minimum": 0,
                "maximum": 1023,
                "type": "integer"
              },
              "y": {
                "minimum": 0,
                "maximum": 1023,
                "type": "integer"
              },
              "w": {
                "minimum": 1,
                "maximum": 64,
                "type": "integer"
              },
              "h": {
                "minimum": 1,
                "maximum": 64,
                "type": "integer"
              },
              "tag": {
                "anyOf": [
                  {
                    "const": "grove",
                    "type": "string"
                  },
                  {
                    "const": "meadow",
                    "type": "string"
                  },
                  {
                    "const": "riverbank",
                    "type": "string"
                  },
                  {
                    "const": "ruin",
                    "type": "string"
                  },
                  {
                    "const": "town",
                    "type": "string"
                  },
                  {
                    "const": "water",
                    "type": "string"
                  },
                  {
                    "const": "path",
                    "type": "string"
                  },
                  {
                    "const": "interior",
                    "type": "string"
                  }
                ]
              },
              "label": {
                "minLength": 1,
                "maxLength": 40,
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
