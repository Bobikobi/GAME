{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "$id": "https://github.com/Bobikobi/GAME/schema/json/map.schema.json",
  "type": "object",
  "required": [
    "format",
    "id",
    "title",
    "creator",
    "type",
    "map"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "description": "Format version of this file.",
      "const": 1,
      "type": "number"
    },
    "id": {
      "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
      "maxLength": 80,
      "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "maxLength": 40,
      "type": "string"
    },
    "creator": {
      "pattern": "^[a-z0-9_-]+$",
      "maxLength": 39,
      "description": "GitHub handle, lowercase.",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "maxLength": 240,
      "type": "string"
    },
    "ai_tools": {
      "maxItems": 8,
      "description": "AI tools used to make this file or its art. Required when any were used.",
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 60,
        "type": "string"
      }
    },
    "items": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "rarity",
          "sprite"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
            "maxLength": 80,
            "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 40,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "maxLength": 240,
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "const": "material",
                "type": "string"
              },
              {
                "const": "food",
                "type": "string"
              },
              {
                "const": "tool",
                "type": "string"
              },
              {
                "const": "fragment",
                "type": "string"
              },
              {
                "const": "treasure",
                "type": "string"
              }
            ]
          },
          "rarity": {
            "description": "Declared rarity. The check compares it with the rarity computed from the data.",
            "anyOf": [
              {
                "const": "common",
                "type": "string"
              },
              {
                "const": "uncommon",
                "type": "string"
              },
              {
                "const": "rare",
                "type": "string"
              },
              {
                "const": "legendary",
                "type": "string"
              }
            ]
          },
          "class": {
            "description": "A base class (plant, wood, fibre, ...) or the id of a class an extension declares under one of them.",
            "anyOf": [
              {
                "const": "plant",
                "type": "string"
              },
              {
                "const": "wood",
                "type": "string"
              },
              {
                "const": "fibre",
                "type": "string"
              },
              {
                "const": "stone",
                "type": "string"
              },
              {
                "const": "clay",
                "type": "string"
              },
              {
                "const": "mineral",
                "type": "string"
              },
              {
                "const": "metal",
                "type": "string"
              },
              {
                "const": "animal",
                "type": "string"
              },
              {
                "const": "meal",
                "type": "string"
              },
              {
                "const": "tool",
                "type": "string"
              },
              {
                "const": "garment",
                "type": "string"
              },
              {
                "const": "jewelry",
                "type": "string"
              },
              {
                "const": "relic",
                "type": "string"
              },
              {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                "maxLength": 80,
                "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                "type": "string"
              }
            ]
          },
          "family": {
            "pattern": "^[a-z0-9_-]+$",
            "maxLength": 24,
            "description": "A group inside the class, for example \"berry\" for every berry. Open: any lowercase word.",
            "type": "string"
          },
          "tags": {
            "maxItems": 8,
            "uniqueItems": true,
            "description": "Open words that describe it, for example \"sweet\" or \"night\".",
            "type": "array",
            "items": {
              "pattern": "^[a-z0-9_-]+$",
              "maxLength": 24,
              "description": "A lowercase word.",
              "type": "string"
            }
          },
          "tier": {
            "minimum": 1,
            "maximum": 20,
            "description": "How advanced it is, from 1. The rarity says how often it appears; the tier says how far up the ladder it is. A tool has the tier of its \"tool\".",
            "type": "integer"
          },
          "sprite": {
            "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+:[a-z0-9_/-]+$",
            "maxLength": 120,
            "description": "A frame of an art kit: \"<kit id>:<frame name>\", for example \"core/base-kit:items/berry\".",
            "type": "string"
          },
          "food": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "satiety"
            ],
            "properties": {
              "satiety": {
                "minimum": 0,
                "maximum": 100,
                "description": "Health points restored when eaten (the meter holds 100 at the start). 0 for a food that only hurts.",
                "type": "integer"
              },
              "hurt": {
                "minimum": 1,
                "maximum": 100,
                "description": "Health points it takes when eaten, at any hour: a bad fruit or a raw herb (G30).",
                "type": "integer"
              }
            }
          },
          "tool": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "tier"
            ],
            "properties": {
              "kind": {
                "anyOf": [
                  {
                    "const": "basket",
                    "type": "string"
                  },
                  {
                    "const": "trowel",
                    "type": "string"
                  },
                  {
                    "const": "axe",
                    "type": "string"
                  },
                  {
                    "const": "staff",
                    "type": "string"
                  },
                  {
                    "const": "hammer",
                    "type": "string"
                  },
                  {
                    "const": "pick",
                    "type": "string"
                  }
                ]
              },
              "tier": {
                "minimum": 1,
                "maximum": 5,
                "description": "Better tools work faster. The calculator clamps the total.",
                "type": "integer"
              },
              "uses": {
                "minimum": 1,
                "maximum": 1000,
                "description": "The tool wears out after this many uses. Left out, the tool lasts (DECISIONS.md, 2026-10-09: the crafting economy).",
                "type": "integer"
              }
            }
          },
          "fragment": {
            "additionalProperties": false,
            "description": "A found scrap that teaches a recipe.",
            "type": "object",
            "required": [
              "unlocks"
            ],
            "properties": {
              "unlocks": {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                "maxLength": 80,
                "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                "type": "string"
              }
            }
          },
          "wear": {
            "additionalProperties": false,
            "description": "Something the character wears (DECISIONS.md, 2026-10-09: the upgrade). A worn item stays in the bag.",
            "type": "object",
            "required": [
              "slot"
            ],
            "properties": {
              "slot": {
                "description": "Where it is worn: head, top, legs (trousers), outfit (takes the top and the legs), feet, jewelry (two places) or hand (a tool).",
                "anyOf": [
                  {
                    "const": "head",
                    "type": "string"
                  },
                  {
                    "const": "top",
                    "type": "string"
                  },
                  {
                    "const": "legs",
                    "type": "string"
                  },
                  {
                    "const": "outfit",
                    "type": "string"
                  },
                  {
                    "const": "feet",
                    "type": "string"
                  },
                  {
                    "const": "jewelry",
                    "type": "string"
                  },
                  {
                    "const": "hand",
                    "type": "string"
                  }
                ]
              },
              "look": {
                "description": "A look: worn on the look layer over the work clothes. It shows and counts for nothing, so it has no effects and no set.",
                "type": "boolean"
              },
              "effects": {
                "minItems": 1,
                "maxItems": 2,
                "description": "Small bonuses while it is worn on the work layer. Two at most, each effect once.",
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "effect",
                    "value"
                  ],
                  "properties": {
                    "effect": {
                      "description": "What a worn item helps: gathering, digging or crafting speed, the craft chance, or rare finds.",
                      "anyOf": [
                        {
                          "const": "gather_speed_pct",
                          "type": "string"
                        },
                        {
                          "const": "dig_speed_pct",
                          "type": "string"
                        },
                        {
                          "const": "craft_speed_pct",
                          "type": "string"
                        },
                        {
                          "const": "craft_chance_pct",
                          "type": "string"
                        },
                        {
                          "const": "rare_find_pct",
                          "type": "string"
                        }
                      ]
                    },
                    "value": {
                      "minimum": 1,
                      "maximum": 100,
                      "description": "Percent, at most the cap of the item's tier (params.wear_effect_max_pct).",
                      "type": "integer"
                    }
                  }
                }
              },
              "set": {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                "maxLength": 80,
                "description": "A set of one creator: when every piece of it is worn, their effects grow by params.wear_set_bonus_pct.",
                "type": "string"
              }
            }
          },
          "premium_later": {
            "description": "Marks a look that may also be sold for premium currency once stage 6 brings it. Only a look item with no effect may carry it, and it stays obtainable in the game (DECISIONS.md, 2026-10-09).",
            "type": "boolean"
          }
        }
      }
    },
    "classes": {
      "maxItems": 10,
      "description": "Classes of your own, each under one base class.",
      "type": "array",
      "items": {
        "additionalProperties": false,
        "description": "A class of your own, declared under one base class. Every rule written for the base class holds for it.",
        "type": "object",
        "required": [
          "id",
          "name",
          "base"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
            "maxLength": 80,
            "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 40,
            "type": "string"
          },
          "base": {
            "description": "plant (leaves, herbs, berries, fruit, roots, mushrooms), wood, fibre (reeds, grass, thread, cloth), stone, clay (clay, sand, pottery, brick), mineral (crystals, gems, salt, ore), metal (waits for its discovery), animal (feathers, wool, hide, bone), meal (cooked food), tool, garment (worn clothes), jewelry, relic (old things from the ruins).",
            "anyOf": [
              {
                "const": "plant",
                "type": "string"
              },
              {
                "const": "wood",
                "type": "string"
              },
              {
                "const": "fibre",
                "type": "string"
              },
              {
                "const": "stone",
                "type": "string"
              },
              {
                "const": "clay",
                "type": "string"
              },
              {
                "const": "mineral",
                "type": "string"
              },
              {
                "const": "metal",
                "type": "string"
              },
              {
                "const": "animal",
                "type": "string"
              },
              {
                "const": "meal",
                "type": "string"
              },
              {
                "const": "tool",
                "type": "string"
              },
              {
                "const": "garment",
                "type": "string"
              },
              {
                "const": "jewelry",
                "type": "string"
              },
              {
                "const": "relic",
                "type": "string"
              }
            ]
          },
          "description": {
            "minLength": 1,
            "maxLength": 240,
            "type": "string"
          }
        }
      }
    },
    "type": {
      "const": "map",
      "type": "string"
    },
    "map": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "width",
        "height",
        "legend",
        "ground",
        "props",
        "spawn",
        "slots"
      ],
      "properties": {
        "climate": {
          "description": "The climate this region declares (NATURE section 2): which ramp set, densities, kinds, air and sound beds the engine reads. Left out, the region is read as temperate.",
          "anyOf": [
            {
              "const": "temperate",
              "type": "string"
            },
            {
              "const": "dry",
              "type": "string"
            },
            {
              "const": "cold",
              "type": "string"
            },
            {
              "const": "wet",
              "type": "string"
            }
          ]
        },
        "creatures": {
          "additionalProperties": false,
          "description": "Cosmetic ambient life (the client draws it behind ?rich= motion; the kernel never sees it): kinds, and the spots where each sits until the player comes close.",
          "type": "object",
          "required": [
            "kinds",
            "spots"
          ],
          "properties": {
            "kinds": {
              "type": "object",
              "patternProperties": {
                "^[a-z0-9_-]+/[a-z0-9_-]+$": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "look",
                    "perch",
                    "alert_tiles",
                    "return_s"
                  ],
                  "properties": {
                    "look": {
                      "description": "The drawing and the way it leaves: a bird takes off, a fish darts, a rabbit bolts, a deer walks off.",
                      "anyOf": [
                        {
                          "const": "bird",
                          "type": "string"
                        },
                        {
                          "const": "fish",
                          "type": "string"
                        },
                        {
                          "const": "rabbit",
                          "type": "string"
                        },
                        {
                          "const": "deer",
                          "type": "string"
                        }
                      ]
                    },
                    "perch": {
                      "description": "What its spots stand on: a non-solid ground tile, a forest tile, or a water tile.",
                      "anyOf": [
                        {
                          "const": "ground",
                          "type": "string"
                        },
                        {
                          "const": "tree",
                          "type": "string"
                        },
                        {
                          "const": "water",
                          "type": "string"
                        }
                      ]
                    },
                    "alert_tiles": {
                      "minimum": 1,
                      "maximum": 8,
                      "description": "It leaves when the player comes within this many tiles.",
                      "type": "integer"
                    },
                    "return_s": {
                      "minimum": 5,
                      "maximum": 600,
                      "description": "Real seconds before it comes back to its spot once the player is away.",
                      "type": "integer"
                    },
                    "hours": {
                      "description": "The game hours it is out, from (inclusive) to (exclusive). Absent: all day, never at night.",
                      "type": "array",
                      "items": [
                        {
                          "minimum": 0,
                          "maximum": 23,
                          "type": "integer"
                        },
                        {
                          "minimum": 1,
                          "maximum": 24,
                          "type": "integer"
                        }
                      ],
                      "additionalItems": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                }
              }
            },
            "spots": {
              "maxItems": 200,
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "kind",
                  "x",
                  "y"
                ],
                "properties": {
                  "kind": {
                    "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                    "maxLength": 80,
                    "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                    "type": "string"
                  },
                  "x": {
                    "minimum": 0,
                    "maximum": 1023,
                    "type": "integer"
                  },
                  "y": {
                    "minimum": 0,
                    "maximum": 1023,
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "width": {
          "minimum": 8,
          "maximum": 1024,
          "type": "integer"
        },
        "height": {
          "minimum": 8,
          "maximum": 1024,
          "type": "integer"
        },
        "legend": {
          "type": "object",
          "patternProperties": {
            "^.$": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "sprite",
                "solid",
                "tag"
              ],
              "properties": {
                "sprite": {
                  "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+:[a-z0-9_/-]+$",
                  "maxLength": 120,
                  "description": "A frame of an art kit: \"<kit id>:<frame name>\", for example \"core/base-kit:items/berry\".",
                  "type": "string"
                },
                "solid": {
                  "type": "boolean"
                },
                "tag": {
                  "anyOf": [
                    {
                      "const": "grove",
                      "type": "string"
                    },
                    {
                      "const": "meadow",
                      "type": "string"
                    },
                    {
                      "const": "riverbank",
                      "type": "string"
                    },
                    {
                      "const": "ruin",
                      "type": "string"
                    },
                    {
                      "const": "town",
                      "type": "string"
                    },
                    {
                      "const": "water",
                      "type": "string"
                    },
                    {
                      "const": "path",
                      "type": "string"
                    },
                    {
                      "const": "interior",
                      "type": "string"
                    }
                  ]
                }
              }
            }
          }
        },
        "ground": {
          "minItems": 8,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "props": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "sprite",
              "x",
              "y",
              "w",
              "h",
              "solid"
            ],
            "properties": {
              "id": {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                "description": "Names the prop so a quest riddle can cite it. Unique on the map.",
                "type": "string"
              },
              "sprite": {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+:[a-z0-9_/-]+$",
                "maxLength": 120,
                "description": "A frame of an art kit: \"<kit id>:<frame name>\", for example \"core/base-kit:items/berry\".",
                "type": "string"
              },
              "x": {
                "minimum": 0,
                "maximum": 1023,
                "description": "Left tile of the footprint.",
                "type": "integer"
              },
              "y": {
                "minimum": 0,
                "maximum": 1023,
                "description": "Top tile of the footprint.",
                "type": "integer"
              },
              "w": {
                "minimum": 1,
                "maximum": 8,
                "description": "Footprint width in tiles. The sprite is drawn bottom-centered on it.",
                "type": "integer"
              },
              "h": {
                "minimum": 1,
                "maximum": 8,
                "description": "Footprint height in tiles.",
                "type": "integer"
              },
              "solid": {
                "type": "boolean"
              },
              "cover": {
                "description": "Hides a player standing on this non-solid prop from a predator's eyes, but never from an adjacent predator.",
                "type": "boolean"
              },
              "fire": {
                "description": "A fire the player may feed by hand. It needs an id.",
                "const": true,
                "type": "boolean"
              },
              "lit_by": {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                "maxLength": 80,
                "description": "Id of the fire prop while whose fire burns this prop's note and sign may be read.",
                "type": "string"
              },
              "sign": {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                "maxLength": 80,
                "description": "Makes the prop a readable sign that names whoever filled this slot, or says it awaits restoration.",
                "type": "string"
              },
              "note": {
                "minLength": 1,
                "maxLength": 240,
                "type": "string",
                "description": "A line shown when the player looks at this prop, for example an old inscription."
              },
              "hazard": {
                "additionalProperties": false,
                "description": "Makes the prop a hazard (G30-G35). It needs an id.",
                "type": "object",
                "required": [
                  "kind",
                  "window"
                ],
                "properties": {
                  "kind": {
                    "description": "A predator hunts the player in its reach and bites until the player stands somewhere safe; a pit, a trap or deep water hurts once each time the player steps onto its footprint.",
                    "anyOf": [
                      {
                        "const": "predator",
                        "type": "string"
                      },
                      {
                        "const": "pit",
                        "type": "string"
                      },
                      {
                        "const": "trap",
                        "type": "string"
                      },
                      {
                        "const": "deep_water",
                        "type": "string"
                      }
                    ]
                  },
                  "window": {
                    "minItems": 1,
                    "uniqueItems": true,
                    "description": "When it acts (G30). Outside its window it is harmless and shows.",
                    "type": "array",
                    "items": {
                      "const": "night",
                      "type": "string"
                    }
                  },
                  "reach": {
                    "minimum": 1,
                    "maximum": 12,
                    "description": "A predator only: how many tiles from its footprint it notices the player. The params hold the default.",
                    "type": "integer"
                  },
                  "round": {
                    "minItems": 4,
                    "maxItems": 64,
                    "description": "A predator only: the closed, four-adjacent loop of tiles it walks after dark. The first tile is inside its prop footprint.",
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": [
                        {
                          "minimum": 0,
                          "maximum": 1023,
                          "type": "integer"
                        },
                        {
                          "minimum": 0,
                          "maximum": 1023,
                          "type": "integer"
                        }
                      ],
                      "additionalItems": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  "pace_ms": {
                    "minimum": 100,
                    "maximum": 10000,
                    "description": "A predator on a round only: game milliseconds per tile. The params hold the default.",
                    "type": "integer"
                  },
                  "eyes": {
                    "minimum": 1,
                    "maximum": 12,
                    "description": "A predator on a round only: how many tiles ahead it sees. The params hold the default.",
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "spawn": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "minimum": 0,
              "maximum": 1023,
              "type": "integer"
            },
            "y": {
              "minimum": 0,
              "maximum": 1023,
              "type": "integer"
            }
          }
        },
