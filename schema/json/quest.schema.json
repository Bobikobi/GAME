{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "$id": "https://github.com/Bobikobi/GAME/schema/json/quest.schema.json",
  "type": "object",
  "required": [
    "format",
    "id",
    "title",
    "creator",
    "type",
    "quest"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "description": "Format version of this file.",
      "const": 1,
      "type": "number"
    },
    "id": {
      "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
      "maxLength": 80,
      "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "maxLength": 40,
      "type": "string"
    },
    "creator": {
      "pattern": "^[a-z0-9_-]+$",
      "maxLength": 39,
      "description": "GitHub handle, lowercase.",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "maxLength": 240,
      "type": "string"
    },
    "ai_tools": {
      "maxItems": 8,
      "description": "AI tools used to make this file or its art. Required when any were used.",
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 60,
        "type": "string"
      }
    },
    "items": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "rarity",
          "sprite"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
            "maxLength": 80,
            "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 40,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "maxLength": 240,
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "const": "material",
                "type": "string"
              },
              {
                "const": "food",
                "type": "string"
              },
              {
                "const": "tool",
                "type": "string"
              },
              {
                "const": "fragment",
                "type": "string"
              },
              {
                "const": "treasure",
                "type": "string"
              }
            ]
          },
          "rarity": {
            "description": "Declared rarity. The check compares it with the rarity computed from the data.",
            "anyOf": [
              {
                "const": "common",
                "type": "string"
              },
              {
                "const": "uncommon",
                "type": "string"
              },
              {
                "const": "rare",
                "type": "string"
              },
              {
                "const": "legendary",
                "type": "string"
              }
            ]
          },
          "sprite": {
            "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+:[a-z0-9_/-]+$",
            "maxLength": 120,
            "description": "A frame of an art kit: \"<kit id>:<frame name>\", for example \"core/base-kit:items/berry\".",
            "type": "string"
          },
          "food": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "satiety"
            ],
            "properties": {
              "satiety": {
                "minimum": 1,
                "maximum": 100,
                "description": "Satiety points restored when eaten (the meter holds 100 at the start).",
                "type": "integer"
              }
            }
          },
          "tool": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "tier",
              "uses"
            ],
            "properties": {
              "kind": {
                "anyOf": [
                  {
                    "const": "basket",
                    "type": "string"
                  },
                  {
                    "const": "trowel",
                    "type": "string"
                  }
                ]
              },
              "tier": {
                "minimum": 1,
                "maximum": 5,
                "description": "Better tools work faster. The calculator clamps the total.",
                "type": "integer"
              },
              "uses": {
                "minimum": 1,
                "maximum": 1000,
                "description": "The tool wears out after this many uses.",
                "type": "integer"
              }
            }
          },
          "fragment": {
            "additionalProperties": false,
            "description": "A found scrap that teaches a recipe.",
            "type": "object",
            "required": [
              "unlocks"
            ],
            "properties": {
              "unlocks": {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                "maxLength": 80,
                "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "type": {
      "const": "quest",
      "type": "string"
    },
    "quest": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "summary",
        "steps",
        "reward"
      ],
      "properties": {
        "giver": {
          "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
          "maxLength": 80,
          "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
          "type": "string"
        },
        "type": {
          "description": "The kind of question the quest asks: one of the twelve in docs/design/GAME_RULES.md section 3. Two quests of one type never follow each other in a chain (G17). Optional in the schema so an old file still reads; the check refuses a quest without one since the core content declared it (GRUNT P-3, 8.10).",
          "anyOf": [
            {
              "const": "investigation",
              "type": "string"
            },
            {
              "const": "discovery",
              "type": "string"
            },
            {
              "const": "fetch_twist",
              "type": "string"
            },
            {
              "const": "dilemma",
              "type": "string"
            },
            {
              "const": "skill",
              "type": "string"
            },
            {
              "const": "collection",
              "type": "string"
            },
            {
              "const": "tending",
              "type": "string"
            },
            {
              "const": "riddle",
              "type": "string"
            },
            {
              "const": "mastery",
              "type": "string"
            },
            {
              "const": "gamble",
              "type": "string"
            },
            {
              "const": "persuasion",
              "type": "string"
            },
            {
              "const": "errand",
              "type": "string"
            }
          ]
        },
        "summary": {
          "minLength": 1,
          "maxLength": 240,
          "type": "string"
        },
        "steps": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "kind",
                  "item",
                  "qty"
                ],
                "properties": {
                  "kind": {
                    "const": "bring",
                    "type": "string"
                  },
                  "item": {
                    "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                    "maxLength": 80,
                    "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                    "type": "string"
                  },
                  "qty": {
                    "minimum": 1,
                    "maximum": 99,
                    "type": "integer"
                  }
                }
              },
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "kind",
                  "recipe"
                ],
                "properties": {
                  "kind": {
                    "const": "make",
                    "type": "string"
                  },
                  "recipe": {
                    "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                    "maxLength": 80,
                    "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                    "type": "string"
                  }
                }
              },
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "kind",
                  "restore"
                ],
                "properties": {
                  "kind": {
                    "const": "restore",
                    "type": "string"
                  },
                  "restore": {
                    "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                    "maxLength": 80,
                    "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                    "type": "string"
                  }
                }
              },
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "kind",
                  "camp"
                ],
                "properties": {
                  "kind": {
                    "const": "build",
                    "type": "string"
                  },
                  "camp": {
                    "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                    "maxLength": 80,
                    "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                    "type": "string"
                  }
                }
              },
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "kind",
                  "slot"
                ],
                "properties": {
                  "kind": {
                    "const": "visit",
                    "type": "string"
                  },
                  "slot": {
                    "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                    "maxLength": 80,
                    "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                    "type": "string"
                  }
                }
              },
              {
                "additionalProperties": false,
                "description": "Bring one of an item that is found, not farmed: only digging gives it, or one timed plant (a resource with hours) that nothing else gives, makes or sells. The journal shows the clue, not a count, until the item is in the bag.",
                "type": "object",
                "required": [
                  "kind",
                  "item",
                  "clue"
                ],
                "properties": {
                  "kind": {
                    "const": "find",
                    "type": "string"
                  },
                  "item": {
                    "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                    "maxLength": 80,
                    "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                    "type": "string"
                  },
                  "clue": {
                    "minLength": 1,
                    "maxLength": 240,
                    "description": "What the journal shows for this step: something to notice or work out. Never the answer, never a count.",
                    "type": "string"
                  }
                }
              },
              {
                "additionalProperties": false,
                "description": "A catch and a reveal (G6): the journal shows the clue, the world holds the answer.",
                "type": "object",
                "required": [
                  "kind",
                  "clue",
                  "props",
                  "answer"
                ],
                "properties": {
                  "kind": {
                    "const": "riddle",
                    "type": "string"
                  },
                  "clue": {
                    "minLength": 1,
                    "maxLength": 240,
                    "description": "What the journal shows for this step: something to notice or work out. Never the answer, never a count.",
                    "type": "string"
                  },
                  "props": {
                    "minItems": 1,
                    "maxItems": 4,
                    "description": "Ids of the map props the riddle reads: the inscriptions it pays for (G8).",
                    "type": "array",
                    "items": {
                      "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                      "maxLength": 80,
                      "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                      "type": "string"
                    }
                  },
                  "answer": {
                    "description": "What solves the riddle. The kernel completes the step on that event and on nothing else.",
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "description": "Solved by digging at this dig spot, whatever comes up.",
                        "type": "object",
                        "required": [
                          "kind",
                          "treasure"
                        ],
                        "properties": {
                          "kind": {
                            "const": "dig",
                            "type": "string"
                          },
                          "treasure": {
                            "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                            "maxLength": 80,
                            "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                            "type": "string"
                          }
                        }
                      },
                      {
                        "additionalProperties": false,
                        "description": "Solved by standing in this slot by day (05:00 to 20:00) or by night.",
                        "type": "object",
                        "required": [
                          "kind",
                          "slot",
                          "at"
                        ],
                        "properties": {
                          "kind": {
                            "const": "visit",
                            "type": "string"
                          },
                          "slot": {
                            "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                            "maxLength": 80,
                            "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                            "type": "string"
                          },
                          "at": {
                            "anyOf": [
                              {
                                "const": "day",
                                "type": "string"
                              },
                              {
                                "const": "night",
                                "type": "string"
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        "requires": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
            "maxLength": 80,
            "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
            "type": "string"
          }
        },
        "reward": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "rep"
          ],
          "properties": {
            "rep": {
              "minimum": 0,
              "maximum": 100,
              "description": "Reputation with the giver. Never traded, so it can be generous.",
              "type": "integer"
            },
            "gold_mg": {
              "minimum": 1,
              "maximum": 10000000,
              "type": "integer"
            },
            "items": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "item",
                  "qty"
                ],
                "properties": {
                  "item": {
                    "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                    "maxLength": 80,
                    "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                    "type": "string"
                  },
                  "qty": {
                    "minimum": 1,
                    "maximum": 999,
                    "type": "integer"
                  }
                }
              }
            },
            "recipes": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
                "maxLength": 80,
                "description": "Stable id \"creator/name\": lowercase letters, digits, \"_\" and \"-\". Never reused once merged.",
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
