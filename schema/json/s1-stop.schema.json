{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Body of POST /api/s1/stop.",
  "type": "object",
  "required": [
    "step"
  ],
  "properties": {
    "step": {
      "pattern": "^[a-z0-9_./:-]+$",
      "minLength": 1,
      "maxLength": 80,
      "description": "The opening step the player reached.",
      "type": "string"
    }
  },
  "$id": "https://github.com/Bobikobi/GAME/schema/json/s1-stop.schema.json"
}
