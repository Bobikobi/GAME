{
  "$schema": "../../../schema/json/npc.schema.json",
  "format": 1,
  "type": "npc",
  "id": "core/elder",
  "title": "Elder Maru",
  "creator": "core",
  "npc": {
    "name": "Elder Maru",
    "sprite": "core/base-kit:chars/elder",
    "place": {
      "slot": "core/elder-house"
    },
    "dialogue": {
      "first": [
        "I am Maru. I kept this town once. Now I keep what is left of it.",
        "You mended the bridge. That is how a town comes back: one thing at a time.",
        "My berries want picking: an old tool of mine pays for it."
      ],
      "stranger": [
        "You came over the old bridge. Nobody has, for a long time.",
        "The mist thickens at dusk. A fire is good company there."
      ],
      "acquaintance": [
        "The ruins keep what we forgot. Dig with care, and leave before the bells.",
        "Every house here was mended by someone. The signs say who."
      ],
      "friend": [
        "You are like the first ones who came back. They did not stay. I hope you do."
      ],
      "family": [
        "This valley is yours as much as mine now."
      ]
    },
    "remarks": [
      {
        "when": {
          "done": [
            "core/a-coin-for-maru"
          ]
        },
        "say": [
          "You read the stones as I did once. Not many can."
        ]
      },
      {
        "when": {
          "done": [
            "core/the-long-night"
          ]
        },
        "say": [
          "You kept a fire of your own a whole night. I will remember that."
        ]
      },
      {
        "when": {
          "done": [
            "core/a-coin-for-maru"
          ],
          "has": [
            "core/herb"
          ]
        },
        "say": [
          "Two herbs and a fire. That is all my mother's tea ever asked."
        ]
      },
      {
        "when": {
          "done": [
            "core/something-warm"
          ]
        },
        "say": [
          "My mother put less salt in. Do not tell Pell I said so."
        ]
      },
      {
        "when": {
          "race": [
            "core/human"
          ]
        },
        "say": [
          "You have the look of the ones who left. Come back, or only passing through?"
        ]
      },
      {
        "when": {
          "race": [
            "core/elf"
          ]
        },
        "say": [
          "Ears like yours are cut on a stone in the ruins. It never said whose."
        ]
      },
      {
        "when": {
          "race": [
            "core/skeleton"
          ]
        },
        "say": [
          "I know your kind from the ground under the town. Welcome back, if it is back."
        ]
      }
    ],
    "topics": [
      {
        "ask": "About the mist",
        "lines": [
          "It comes down from the hills at dusk. It was thinner once.",
          "Things move in it at night. Bells too, and nobody there to ring them.",
          "I do not fear it. But I do not walk the ruins after dark. Nor should you."
        ]
      },
      {
        "ask": "About the ruins",
        "lines": [
          "South-east, past the broken arch. Houses, a hall, a garden, all fallen in.",
          "They left in a hurry and left things behind. A trowel finds them.",
          "A lantern stands at their east edge, one by the town. I read the stones once."
        ]
      },
      {
        "ask": "About the town",
        "lines": [
          "A market, a well with sweet water, a garden behind every second house.",
          "Most of it is under the weeds now. Roofs gone. Paths lost.",
          "Every place someone mends comes back out of the mist. Start small."
        ]
      },
      {
        "ask": "About the lanterns",
        "when": {
          "done": [
            "core/a-coin-for-maru"
          ]
        },
        "lines": [
          "They light at dusk. Nobody fills them. Nobody ever did, that I saw.",
          "I think they watch the hills, where the mist comes from."
        ]
      }
    ],
