[Unit]
Description=Spend the free PixelLab accounts' daily generations on the game's queue
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/art-pixellab/env
ExecStart=%h/.local/share/art-pixellab/nightly.sh
Nice=15
TimeoutStartSec=3h
