{
  "name": "game-monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check": "tsx tools/src/cli.ts check",
    "sheet": "tsx tools/src/sheet.ts",
    "values": "tsx tools/src/cli.ts values",
    "bundle": "tsx tools/src/cli.ts bundle",
    "schemas": "tsx schema/src/emit.ts",
    "dev": "pnpm bundle && pnpm --filter game dev",
    "build": "pnpm bundle && pnpm --filter game build && pnpm site",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx server/src/migrate-cli.ts",
    "kit:gen": "tsx tools/src/kit/gen.ts",
    "art:drafts": "tsx tools/src/art/drafts.ts",
    "art:status": "tsx tools/src/art/status-cli.ts",
    "art:wave": "tsx tools/src/art/wave-cli.ts",
    "art:measure": "tsx tools/src/art/measure-cli.ts",
    "art:edges": "tsx tools/src/art/edges-cli.ts",
    "art:water": "tsx tools/src/art/water-cli.ts",
    "art:sand": "tsx tools/src/art/sand-cli.ts",
    "art:rubble": "tsx tools/src/art/rubble-cli.ts",
    "art:bridge": "tsx tools/src/art/bridge-cli.ts",
    "art:run": "tsx tools/src/art/run-cli.ts",
    "art:pick": "tsx tools/src/art/pick-cli.ts",
    "art:gallery": "tsx tools/src/art/gallery-cli.ts",
    "kit:notes": "tsx tools/src/kit/notes.ts",
    "kit:import": "tsx tools/src/kit/import.ts",
    "kit:ink": "tsx tools/src/kit/ink.ts",
    "kit:sketches": "tsx tools/src/kit/sketches.ts",
    "anim": "tsx tools/src/anim/cli.ts",
    "e2e": "tsx game/e2e/run.ts all",
    "e2e:group": "tsx game/e2e/run.ts",
    "e2e:shop": "tsx game/e2e/shop.ts",
    "e2e:load": "tsx game/e2e/load.ts",
    "e2e:3d": "tsx game/e2e/play3d.ts",
    "credits": "tsx tools/src/cli.ts credits",
    "board": "tsx tools/src/cli.ts board",
    "loop": "tsx tools/src/loop/cli.ts",
    "streams": "tsx tools/src/streams/cli.ts",
    "quests": "tsx tools/src/quests/cli.ts",
    "map:difficulty": "tsx tools/src/balance/reckon-cli.ts",
    "balance": "tsx tools/src/balance/cli.ts",
    "tree:coverage": "tsx tools/src/tree/cli.ts",
    "hub:data": "tsx tools/src/hub/cli.ts",
    "hub:same": "tsx tools/src/hub/same.ts",
    "mcp": "tsx mcp/src/server.ts",
    "private": "tsx tools/src/private-strings-cli.ts",
    "verify": "pnpm schemas --verify && pnpm check && pnpm private && pnpm bundle && pnpm lint && pnpm typecheck && pnpm test && pnpm --filter game build && pnpm site && pnpm --filter web test",
    "site": "tsx tools/src/site/build-3d.ts && tsx tools/src/site/scene.ts && tsx tools/src/hub/cli.ts && pnpm --filter web build && tsx tools/src/site/copy-play.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
