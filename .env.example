# Names only; the values live in the Vercel project and the repository settings (docs/team/PLATFORM.md, section 9.3).
# A read-only token for `pnpm hub:data` in Vercel builds; without it the hub's GitHub sections are empty.
HUB_GITHUB_TOKEN=
# The hourly refresh (GitHub Actions secret).
VERCEL_DEPLOY_HOOK=
# The stage-1 service, set by the Upstash integration in the Vercel project (section 9.4).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# The hourly refresh reads the counters with the read-only token (GitHub Actions secrets KV_REST_API_URL and this one).
KV_REST_API_READ_ONLY_TOKEN=
# Alternatively, a database linked by hand:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
